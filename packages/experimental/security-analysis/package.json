    "./web": {
      "types": "./lib/types/web-provider.d.ts",
      "default": "./lib/web.js"
    },
    "./laboratory": {
      "types": "./lib/types/laboratory.d.ts",
      "default": "./lib/laboratory.js"
    },
    "./offline": {
      "types": "./lib/types/offline-provider.d.ts",
      "default": "./lib/offline.js"
    }
  },
  "files": [
    "lib/index.js",
    "lib/workbench.js",
    "lib/environment.js",
    "lib/ghidra.js",
    "lib/frida.js",
    "lib/android.js",
    "lib/commands.js",
    "lib/legacy.js",
    "lib/web.js",
