{
  "name": "@deepseek-ai/dsh-experimental-security-analysis",
  "description": "Scoped reverse engineering with GhidraMCP, Frida, evidence records, and reconnaissance delegation",
  "version": "0.1.6-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
